{
  "name": "centro-terapias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run tests",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "format": "prettier --write src tests e2e *.ts *.json",
    "local:start": "node scripts/start-local.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "dev:local": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "team:check": "node scripts/provision-team.mjs",
    "team:invite": "node scripts/provision-team.mjs --execute",
    "team:first:check": "node scripts/provision-team.mjs --first-admin",
    "team:first:invite": "node scripts/provision-team.mjs --first-admin --execute",
    "local:functions": "supabase functions serve --env-file supabase/functions/.env.local --network-id centro-terapias-local",
    "test:cedula:local": "node scripts/verify-cedula-local.mjs",
    "test:connected": "playwright test --config playwright.connected.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
